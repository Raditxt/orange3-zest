		<properties node_id="10" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x03\x8d\x00\x00\x01\x90\x00\x00\x06\xae\x00\x00\x04\x06\x00\x00\x03\x8e\x00\x00\x01\xae\x00\x00\x06\xad\x00\x00\x04\x05\x00\x00\x00\x00\x00\x00\x00\x00\x0c\x00\x00\x00\x03\x8e\x00\x00\x01\xae\x00\x00\x06\xad\x00\x00\x04\x05', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import numpy as np\nSTEM = "heart_zestpca_norm-on_25pc"\nnp.save(rf"D:\\Kuroya\\Project\\orange3-zest\\evidence\\pca\\{STEM}_components.npy", in_data.X)\nprint(STEM, in_data.X.shape)\nout_data = in_data', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa5\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
